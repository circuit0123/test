# Copy to .env and adjust. .env is gitignored: never commit real secrets.
ENV=development
LOG_LEVEL=INFO

# Used by docker compose to create the Postgres user/database.
POSTGRES_USER=circuit
POSTGRES_PASSWORD=circuit
POSTGRES_DB=circuit
# Used by the app. Must match the values above.
DATABASE_URL=postgresql+psycopg://circuit:circuit@localhost:5432/circuit

# Neo4j: compose sets this password on first start (minimum 8 characters).
NEO4J_PASSWORD=circuit-dev-password
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

REDIS_URL=redis://localhost:6379/0

# Centre of the generated seed data.
CITY_NAME=Bengaluru
CITY_CENTER_LAT=12.9716
CITY_CENTER_LNG=77.5946

# Embeddings: fastembed downloads BAAI/bge-small-en-v1.5 (~70 MB) on first use.
# Use "fake" for a quick offline load (vectors are not meaningful).
EMBEDDING_PROVIDER=fastembed

# Real auth (later): your identity provider's JWKS URL, issuer and audience.
# JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
# JWT_ISSUER=https://<your-app>.clerk.accounts.dev
# JWT_AUDIENCE=

# Local-only test login. The app refuses to start with DEV_AUTH=true in production.
# The secret signs local test tokens; make your own with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
DEV_AUTH=true
DEV_AUTH_SECRET=local-dev-only-replace-me-with-a-random-string

# Background jobs (match computation every MATCHING__JOB_INTERVAL_HOURS).
SCHEDULER_ENABLED=true
MATCH_JOB_ON_STARTUP=false
# Matching weights and knobs: see MatchingSettings in app/config.py, e.g.
# MATCHING__W_COMPLEMENTARITY=0.5
# MATCHING__BRIDGE_SHARE=0.25
